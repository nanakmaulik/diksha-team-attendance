"use client";
import { useEffect, useMemo, useState } from "react";
import { timeLabel, TeamSlug } from "@/lib/sevaExpansion";
type Shift={id:string;start_time:string;end_time:string;sort_order:number};
type Member={id:string;name:string;location:string;is_leader:boolean;shifts:Shift[]};
export function SevaExpansionForm({slug,title}:{slug:TeamSlug;title:string}) {
  const [members,setMembers]=useState<Member[]>([]);
  const [memberId,setMemberId]=useState(""); const [shiftId,setShiftId]=useState("");
  const [status,setStatus]=useState<"PRESENT"|"LEAVE">("PRESENT");
  const [reason,setReason]=useState(""); const [notice,setNotice]=useState("");
  const [loading,setLoading]=useState(true); const [saving,setSaving]=useState(false);
  useEffect(()=>{fetch(`/api/seva/${slug}`,{cache:"no-store"}).then(r=>r.json()).then(x=>{if(x.error)throw Error(x.error);setMembers(x.members||[])}).catch(e=>setNotice(e.message)).finally(()=>setLoading(false))},[slug]);
  const member=useMemo(()=>members.find(m=>m.id===memberId),[members,memberId]);
  const groups=Array.from(new Set(members.map(m=>m.location)));
  async function submit(e:React.FormEvent) {
    e.preventDefault();setNotice("");setSaving(true);
    try {
      const r=await fetch(`/api/seva/${slug}`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({memberId,shiftId,status,reason})});
      const x=await r.json();if(!r.ok)throw Error(x.error||"Submission failed");
      setNotice(`✅ ${status==="LEAVE"?"Leave":"Attendance"} saved for today`);setMemberId("");setShiftId("");setReason("");
    } catch(e) {setNotice(`⚠️ ${e instanceof Error?e.message:"Error"}`)}finally{setSaving(false)}
  }
  return <main className="min-h-screen bg-zinc-50 px-4 py-8 text-zinc-900"><div className="mx-auto max-w-xl rounded-2xl border bg-white p-6 shadow-sm">
    <p className="font-semibold text-orange-700">श्री हरिवंश</p><h1 className="mt-2 text-2xl font-bold">{title} Attendance</h1><p className="mb-6 text-sm text-zinc-500">Shift-wise seva attendance · GPS configuration pending</p>
    {loading?<p>Loading members…</p>:<form onSubmit={submit} className="space-y-4">
      <label className="block text-sm font-semibold">Sadhak / Sevadar<select required value={memberId} onChange={e=>{setMemberId(e.target.value);setShiftId("")}} className="mt-2 w-full rounded-lg border p-3"><option value="">Choose member</option>{groups.map(group=><optgroup key={group} label={group}>{members.filter(m=>m.location===group).map(m=><option key={m.id} value={m.id}>{m.name}{m.is_leader?" (Leader)":""}</option>)}</optgroup>)}</select></label>
      <label className="block text-sm font-semibold">Assigned Shift<select required value={shiftId} onChange={e=>setShiftId(e.target.value)} className="mt-2 w-full rounded-lg border p-3"><option value="">Choose shift</option>{(member?.shifts||[]).sort((a,b)=>a.start_time.localeCompare(b.start_time)).map(s=><option key={s.id} value={s.id}>{timeLabel(s.start_time)} – {timeLabel(s.end_time)}{s.end_time<=s.start_time?" (next day)":""}</option>)}</select></label>
      {member && !member.shifts.length && <p className="rounded-lg bg-amber-50 p-3 text-sm text-amber-900">Shift timing is pending confirmation. Admin can add it later.</p>}
      <fieldset className="flex gap-4 rounded-lg border p-3"><legend className="px-2 text-sm font-semibold">Mark attendance</legend><label><input type="radio" checked={status==="PRESENT"} onChange={()=>setStatus("PRESENT")}/> Present</label><label><input type="radio" checked={status==="LEAVE"} onChange={()=>setStatus("LEAVE")}/> Leave</label></fieldset>
      {status==="LEAVE"&&<label className="block text-sm">Leave reason<textarea className="mt-2 w-full rounded-lg border p-3" required maxLength={1000} value={reason} onChange={e=>setReason(e.target.value)}/></label>}
      <button disabled={saving||!shiftId} className="w-full rounded-xl bg-orange-700 px-4 py-3 font-semibold text-white disabled:opacity-50">{saving?"Submitting…":"Submit attendance"}</button>
    </form>}
    {notice&&<p role="status" className="mt-4 rounded-lg bg-zinc-100 p-3 text-sm">{notice}</p>}<a href={`/admin/seva/${slug}`} className="mt-6 block text-center text-sm text-orange-700">Admin dashboard</a>
  </div></main>;
}
